# Copy this file to .env and fill it in.

# Time zone for the browser, transcript timestamps and folder dates.
# Use the same value your laptop uses, for example America/New_York.
TZ=America/New_York

# Browser language. Match your laptop's browser.
LOCALE=en-US

# ntfy topic for phone alerts. Leave empty to only write alerts to the log.
# Pick a long random name (openssl rand -hex 16): the topic is effectively a password.
NTFY_TOPIC=
NTFY_URL=https://ntfy.sh

# Outside watcher (healthchecks.io, README step 9): each check's ping URL, or leave empty.
# HC_MACHINE_URL is pinged every 5 minutes while the machine is up, HC_CHAT_BACKUP_URL only while
# chat-backup is healthy. The URLs work like passwords, so they belong here and never in git.
HC_MACHINE_URL=
HC_CHAT_BACKUP_URL=

# Also push an alert for every newly created chat (tapping it opens the chat): true or false.
# Only chats created in the last two hours alert, so older chats found later stay quiet.
NOTIFY_NEW_CHATS=false

# Only download chats created or used in the last N days. Older chats still appear in
# INDEX.md by title, and are downloaded as soon as you use them again. 0 = your whole history.
DOWNLOAD_DAYS=0

# Hours (local time, TZ above) when ChatGPT gets no requests at all, for example 1-8 for
# 1:00 until 8:00. Chats you use then are saved after it ends. Empty = check around the clock.
QUIET_HOURS=

# INFO for normal use. DEBUG also logs the start of every API response,
# which is what you want when something about ChatGPT's data shape changed.
LOG_LEVEL=INFO
