[Unit]
Description=chat-backup: tell the phone how the previous boot ended
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Change these two lines as in chat-backup.service: your Linux user (it must be able to read the
# system journal: a member of the adm or systemd-journal group) and where chat-backup lives.
User=YOUR_USERNAME
Environment=APP_DIR=/home/YOUR_USERNAME/lil-tykes/chat-backup
ExecStart=/bin/sh ${APP_DIR}/host/boot-report.sh

[Install]
WantedBy=multi-user.target
